# Copy to .env (already gitignored) and fill in real values locally.

# Which LLM provider does the extraction call: "anthropic" (default) or
# "openai". See slyp/extraction.py.
SLYP_MODEL_PROVIDER=anthropic

# Only the key matching SLYP_MODEL_PROVIDER needs a real value. Keep them
# in their own variables - putting one provider's key under the other's
# name is a guaranteed 401, not a working swap.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Required. Optional (defaults to claude-sonnet-5) only when
# SLYP_MODEL_PROVIDER=anthropic - there's no safe default model name to
# guess for a provider switch, so this must be set explicitly for openai.
SLYP_EXTRACTION_MODEL=

# Backend (main.py) - comma-separated list of frontend origins CORS should
# allow. Defaults to http://localhost:3000 if unset. Not "*".
SLYP_CORS_ORIGINS=http://localhost:3000

# Frontend (Next.js) - must be prefixed NEXT_PUBLIC_ to be readable in the
# browser. Base URL of the running API, no trailing slash. Defaults to
# http://localhost:8000 if unset - see lib/Api.ts.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
