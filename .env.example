# Copy to .env (already gitignored) and fill in real values locally.

ANTHROPIC_API_KEY=

# Optional - defaults to claude-sonnet-5 if unset. See slyp/extraction.py.
SLYP_EXTRACTION_MODEL=

# Backend (main.py) - comma-separated list of frontend origins CORS should
# allow. Defaults to http://localhost:3000 if unset. Not "*".
SLYP_CORS_ORIGINS=http://localhost:3000

# Frontend (Next.js) - must be prefixed NEXT_PUBLIC_ to be readable in the
# browser. Base URL of the running API, no trailing slash. Defaults to
# http://localhost:8000 if unset - see lib/Api.ts.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
